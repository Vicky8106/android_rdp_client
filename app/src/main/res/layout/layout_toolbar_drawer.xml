<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Translucent Drawer Card Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/drawerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#E61E1E2E"
        app:cardCornerRadius="0dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/drawerContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <!-- Row 1: Session Title, Status & Close Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_desktop_windows"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvSessionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="RDP Session"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSessionResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#A0FFFFFF"
                    android:textSize="11sp"
                    android:text="1920x1080"
                    android:layout_marginEnd="12dp" />

                <ImageButton
                    android:id="@+id/btnCloseDrawer"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    android:rotation="90"
                    app:tint="@android:color/white"
                    android:contentDescription="Close Drawer" />
            </LinearLayout>

            <!-- Row 2: Action Buttons Carousel (Keyboard, Overlays, Zoom, Macros, Disconnect) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Toggle Soft Input Method (IME) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleIme"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Keyboard"
                        app:icon="@drawable/ic_edit"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp" />

                    <!-- Toggle Compose Virtual Keys Overlay -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleVirtualKeys"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Keys Bar"
                        app:icon="@drawable/ic_key"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp" />

                    <!-- Toggle Compose Virtual Mouse Pill -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleVirtualMouse"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Mouse Pill"
                        app:icon="@drawable/ic_gesture"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp" />

                    <!-- Zoom Lock Toggle -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoomLock"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Lock Zoom"
                        app:icon="@drawable/ic_lock"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp" />

                    <!-- Zoom Reset (Fit to Screen) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoomReset"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Fit Screen"
                        app:icon="@drawable/ic_screen_rotation"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp" />

                    <!-- Zoom 1:1 Native Resolution -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoom100"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="1:1"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp" />

                    <!-- Quick Macro: Send Ctrl+Alt+Del -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMacroCad"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Ctrl+Alt+Del"
                        app:icon="@drawable/ic_bolt"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp" />

                    <!-- Quick Macro: Send Windows Key -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMacroWin"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Win Key"
                        app:icon="@drawable/ic_desktop_windows"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp" />

                    <!-- Disconnect Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDisconnect"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Disconnect"
                        app:icon="@drawable/ic_power"
                        app:backgroundTint="#D32F2F"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Row 3: Segmented Selectors: View Mode & Gesture Style -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="2">

                <!-- View Mode Toggle Group -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Mode"
                        android:textColor="#B0FFFFFF"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleGroupViewMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModeNormal"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:text="Normal"
                            android:textSize="10sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModeNoInput"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:text="View-Only"
                            android:textSize="10sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModeNoVideo"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:text="No-Video"
                            android:textSize="10sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <!-- Gesture Style Toggle Group -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gesture Style"
                        android:textColor="#B0FFFFFF"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleGroupGestureStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGestureAuto"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:text="Auto"
                            android:textSize="10sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGestureTouchscreen"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:text="Touch"
                            android:textSize="10sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGestureTouchpad"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:text="Trackpad"
                            android:textSize="10sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Drawer Pull Tab Handle -->
    <LinearLayout
        android:id="@+id/drawerTabHandle"
        android:layout_width="72dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drawer_pull_tab"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/drawerHandleBar"
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:background="@drawable/bg_pill_indicator" />
    </LinearLayout>

</LinearLayout>
